# Copy this file to ".env" for local runs, or to /etc/discord_bot_ebay.env on the
# server, and fill in the real values. Never commit the populated file.
DISCORD_TOKEN=your_discord_bot_token

# Optional. Route eBay requests through a residential proxy to avoid datacenter-IP
# blocking (required on hosts like DigitalOcean, where eBay otherwise returns HTTP 403).
# Use the endpoint from your proxy provider; leave empty for a direct connection.
#   EBAY_PROXY=http://username:password@host:port
EBAY_PROXY=
