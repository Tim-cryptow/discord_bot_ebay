[Unit]
Description=Discord Bot
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=discordbot
Group=discordbot
WorkingDirectory=/home/discordbot/discord_bot
ExecStart=/home/discordbot/discord_bot/venv/bin/python /home/discordbot/discord_bot/bot.py
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=discordbot

# Secrets are loaded from a root-owned file kept out of version control.
# Create /etc/discord_bot_ebay.env containing: DISCORD_TOKEN=your_real_token
EnvironmentFile=/etc/discord_bot_ebay.env

# Light hardening.
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
